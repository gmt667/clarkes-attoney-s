# Contact form email delivery
# Server-only. Do not expose this value with NEXT_PUBLIC_.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Use a sender from a verified domain in Resend.
RESEND_FROM_EMAIL=Clarkes Attorneys <noreply@clarkesattorneys.mw>

# Database storage is optional.
DATABASE_URL=postgresql://user:password@host:5432/clarkes

# Sanity CMS is optional. Without these, the site uses static content.
SANITY_PROJECT_ID=your_project_id
SANITY_DATASET=production
SANITY_READ_TOKEN=sk_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
